package main

import (
	"context"
	"fmt"
	"log"
	"time"

	"example.com/myapp/mongodb" // se asume que el código anterior está en este paquete
	"go.mongodb.org/mongo-driver/v2/bson"
	"go.mongodb.org/mongo-driver/v2/mongo"
)

// Estructura del documento de usuario
type User struct {
	ID       string    `bson:"_id,omitempty"`
	Username string    `bson:"username"`
	Email    string    `bson:"email"`
	Age      int       `bson:"age"`
	Created  time.Time `bson:"created"`
}

func main() {
	// Conectar a MongoDB
	uri := "mongodb://localhost:27017"
	client, err := mongodb.Connect(uri)
	if err != nil {
		log.Fatalf("error al conectar a MongoDB: %v", err)
	}

	// Asegurar la desconexión al finalizar el programa
	defer func() {
		if err := mongodb.Disconnect(); err != nil {
			log.Printf("error al desconectar de MongoDB: %v", err)
		}
	}()

	// Comprobar el estado de la conexión
	if err := mongodb.Ping(); err != nil {
		log.Fatalf("fallo en ping: %v", err)
	}
	fmt.Println("¡Conexión a MongoDB exitosa!")

	// Obtener base de datos y colección
	coll, err := mongodb.GetCollection("testdb", "users")
	if err != nil {
		log.Fatalf("error al obtener la colección: %v", err)
	}

	// Insertar documento
	if err := insertUser(coll); err != nil {
		log.Fatalf("error al insertar usuario: %v", err)
	}

	// Consultar documentos
	if err := findUsers(coll); err != nil {
		log.Fatalf("error al consultar usuarios: %v", err)
	}

	// Actualizar documento
	if err := updateUser(coll); err != nil {
		log.Fatalf("error al actualizar usuario: %v", err)
	}

	// Eliminar documento
	if err := deleteUser(coll); err != nil {
		log.Fatalf("error al eliminar usuario: %v", err)
	}

	// Demostrar la función de reconexión
	fmt.Println("\nDemostración de reconexión tras desconectar:")
	if err := mongodb.Disconnect(); err != nil {
		log.Fatalf("error al desconectar: %v", err)
	}
	fmt.Println("Desconectado de MongoDB")

	// Reconectar
	client, err = mongodb.Connect(uri)
	if err != nil {
		log.Fatalf("error al reconectar a MongoDB: %v", err)
	}
	fmt.Println("¡Reconexión a MongoDB exitosa!")

	// Verificar que la conexión es válida
	if err := mongodb.Ping(); err != nil {
		log.Fatalf("fallo en ping tras reconectar: %v", err)
	}
	fmt.Println("Estado de conexión correcto tras reconectar")
}

// Insertar documento de usuario
func insertUser(coll *mongo.Collection) error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Crear documento de usuario
	user := User{
		Username: "zhangsan",
		Email:    "zhangsan@example.com",
		Age:      30,
		Created:  time.Now(),
	}

	// Insertar documento
	result, err := coll.InsertOne(ctx, user)
	if err != nil {
		return fmt.Errorf("error al insertar documento: %w", err)
	}
	fmt.Printf("Usuario insertado con éxito, ID: %v\n", result.InsertedID)
	return nil
}

// Consultar documentos de usuario
func findUsers(coll *mongo.Collection) error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Crear filtro
	filter := bson.D{{Key: "age", Value: bson.D{{Key: "$gte", Value: 18}}}}

	// Ejecutar la consulta
	cursor, err := coll.Find(ctx, filter)
	if err != nil {
		return fmt.Errorf("error en la consulta: %w", err)
	}
	defer cursor.Close(ctx)

	// Procesar resultados
	var users []User
	if err := cursor.All(ctx, &users); err != nil {
		return fmt.Errorf("error al procesar resultados: %w", err)
	}

	fmt.Printf("%d usuarios encontrados:\n", len(users))
	for _, user := range users {
		fmt.Printf("- Usuario: %s, Email: %s, Edad: %d\n", user.Username, user.Email, user.Age)
	}
	return nil
}

// Actualizar documento de usuario
func updateUser(coll *mongo.Collection) error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Crear filtro
	filter := bson.D{{Key: "username", Value: "zhangsan"}}

	// Crear el contenido de actualización
	update := bson.D{{Key: "$set", Value: bson.D{{Key: "age", Value: 31}}}}

	// Ejecutar la actualización
	result, err := coll.UpdateOne(ctx, filter, update)
	if err != nil {
		return fmt.Errorf("error al actualizar documento: %w", err)
	}

	fmt.Printf("Usuario actualizado, coincidencias: %d, modificados: %d\n", result.MatchedCount, result.ModifiedCount)
	return nil
}

// Eliminar documento de usuario
func deleteUser(coll *mongo.Collection) error {
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	// Crear filtro
	filter := bson.D{{Key: "username", Value: "zhangsan"}}

	// Ejecutar la eliminación
	result, err := coll.DeleteOne(ctx, filter)
	if err != nil {
		return fmt.Errorf("error al eliminar documento: %w", err)
	}

	fmt.Printf("Usuario eliminado, cantidad: %d\n", result.DeletedCount)
	return nil
}